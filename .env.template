# repo3 environment template.
#
# Copy to repo3/.env and fill in. NEVER commit the filled-in file --
# .gitignore covers .env. This template holds variable NAMES and non-secret
# path defaults only; no key material belongs here.
#
# ALL keys that ever sat on srv13 are burned (that box was compromised).
# Rotate at the provider before reusing any of them.

########## Required for most runs ##########
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=          # embeddings for the RAG vector_db (text-embedding-3-small)
ANTHROPIC_API_KEY=       # only if running Claude Code against Anthropic directly

########## Situational ##########
# ANTHROPIC_AUTH_TOKEN=$DEEPSEEK_API_KEY
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# GEOS_OPENROUTER_API_KEY=     # legacy alias kept alongside OPENROUTER_API_KEY
# CURSOR_API_KEY=              # cursor_composer2 agent
# HF_ACCESS_TOKEN=
# SUPERVISOR_LLM_API_KEY=      # interactive-autonomy supervisor MCP

########## Container backend ##########
# docker is the default. serv6/9/10/11 have docker disabled by the admins;
# use enroot there. See docs/ENROOT.md.
# REPO3_CONTAINER_BACKEND=enroot
# REPO3_ENROOT_CONTAINER=geos-eval          # named container (default geos-eval)
# REPO3_ENROOT_IMAGE=                       # .sqsh path, if not the default
# REPO3_DIR=                                # repo root override

########## Non-secret paths (re-point per host) ##########
# GEOSX_EXECUTABLE=       # srv13 value was
#                         # /data/jixuan/geophysics/GEOS/install-your-platform-release/bin/geosx
#                         # -- that host is gone; re-point or disable the geosx hook.
# GEOS_DATA_DIR=          # overrides DEFAULT_GEOS_LIB_DIR in src/runner/constants.py
# GEOS_VECTOR_DB_DIR=     # overrides DEFAULT_VECTOR_DB_DIR

########## Full env-var inventory referenced by src/ scripts/ plugin/ ##########
# Read, not necessarily set by you -- most have defaults in constants.py.
# ANTHROPIC_API_KEY            GEOS_HOOK_MAX_RETRIES
# ANTHROPIC_AUTH_TOKEN         GEOS_HOOK_SCHEMA_PATH
# CLAUDE_PLUGIN_ROOT           GEOS_POST_HOOK_EVENTS_PATH
# CLAUDE_PROJECT_DIR           GEOS_RUNTIME_HOST_DIR
# DEEPSEEK_API_KEY             GEOS_VECTOR_DB_DIR
# GEOS_DATA_DIR                LOGNAME
# GEOS_EMBEDDING_MODEL_NAME    MEMORY_EMBED_MODEL
# GEOS_EVOLVE_CHECKS           OPENAI_API_KEY
# GEOS_EVOLVE_FEEDBACK_SHAPE   OPENROUTER_API_BASE
# GEOS_HOOK_EVENTS_PATH        OPENROUTER_API_KEY
# GEOS_HOOK_GEOSX_BIN          OPENROUTER_BASE_URL
# GEOS_HOOK_GEOSX_LDPATH       REPO3_CONTAINER_BACKEND
# GEOS_HOOK_GEOSX_TIMEOUT      REPO3_ENROOT_CONTAINER
# GEOS_HOOK_GEOSX_TOTAL_BUDGET REPO3_ENROOT_IMAGE
# GEOS_HOOK_INPUTS_DIR         SUPERVISOR_LLM_API_KEY / _MODEL / _BASE_URL
# SUPERVISOR_PROMPT_VARIANT    SUPERVISOR_SPEC_PATH / SUPERVISOR_TASK_NAME
# USER                         XMLLINT_WORKSPACE_DIR
